{
    "rust-analyzer.showUnlinkedFileNotification": false,
    "rust-analyzer.check.overrideCommand": [
        "cargo",
        "xtask",
        "clippy",
        "--",
        "--workspace",
        "--quiet"
    ],
    "rust-analyzer.linkedProjects": [
        "Cargo.toml",
        "crates/observ-trace-ebpf/Cargo.toml",
        "crates/observ-cpu-ebpf/Cargo.toml",
        "crates/observ-memory-ebpf/Cargo.toml",
        "crates/observ-disk-ebpf/Cargo.toml",
        "crates/observ-network-ebpf/Cargo.toml",
    ],
    // no need to cargo check in every workspace member
    // cargo xtask check does it for us
    "rust-analyzer.check.invocationStrategy": "once",
    // so that cargo check builds with the correct targets
    "rust-analyzer.cargo.buildScripts.overrideCommand": [
        "cargo",
        "xtask",
        "clippy",
        "--",
        "--workspace",
        "--quiet"
    ],
    // if set to workspace it tries to run cargo xtask inside
    // observ-ebpf which is problematic as xtask doesnt exists in there
    "rust-analyzer.cargo.buildScripts.invocationStrategy": "once",
    "rust-analyzer.cargo.features": "all",
    "rust-analyzer.runnables.extraArgs": ["--target=x86_64-unknown-linux-gnu"],
    "rust-analyzer.procMacro.enable": false,
    "rust-analyzer.cargo.cfgs": ["debug_assertions", "target_arch=bpf", "target_arch=x86_64"],
    "rust-analyzer.checkOnSave": true,
    "files.associations": {
        "blk_types.h": "c",
        "types.h": "c",
        "cgroup_defs.h": "c",
        "kernfs.h": "c",
        "bpf_core_read.h": "c",
        "bpf_helpers.h": "c",
        "inet_sock.h": "c",
        "sock.h": "c",
        "blk_cgroup.h": "c",
        "blkdev.h": "c",
        "fdtable.h": "c",
        "fs.h": "c",
        "sched.h": "c",
        "blk_mq.h": "c",
        "tcp.h": "c",
        "net.h": "c",
        "ranges": "c",
        "io_context": "c",
        "thread": "c",
        "uio.h": "c",
        "socket.h": "c"
    }
}
