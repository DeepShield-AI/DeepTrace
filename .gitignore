### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/
.idea/
.vscode/
.venv/
agent/target
agent/Cargo.lock
agent/*.txt
agent/*.json
agent/config/default.toml
# These are backup files generated by rustfmt
**/*.rs.bk
tests/dev
tests/output/*
tests/protocols/
tests/workload/env/
tests/workload/__pycache__
tests/workload/**/__pycache__/
tests/**.py
resources/docker/images/**/ubuntu.*
**/__pycache__/